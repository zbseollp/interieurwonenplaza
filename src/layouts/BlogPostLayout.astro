---
import type { CollectionEntry } from 'astro:content';
import ArticleLayout from './ArticleLayout.astro';
import { getEntryBlogImages, resolveFeaturedImageAlt } from '../lib/media';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, excerpt, pubDate, author } = entry.data;
// Pass the body so a post with no image field still uses its first inline image.
const { hero, featured, og } = getEntryBlogImages(entry.data, entry.body);
const imageAlt = resolveFeaturedImageAlt(entry.data, title);
---
<ArticleLayout
  title={title}
  description={description || excerpt}
  image={hero}
  featuredImage={featured}
  ogImage={og}
  imageAlt={imageAlt}
  date={pubDate.toISOString()}
  author={author}
>
  <slot name="header" slot="header" />
  <slot />
  <slot name="footer" slot="footer" />
</ArticleLayout>
